# GEMINI_API_KEY: Required for Gemini AI API calls (scripts, reference-guided images, Lyria BGM).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional for ElevenLabs character voice synthesis.
# Leave blank if testing without ElevenLabs; the studio will warn and fall back cleanly.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Python Creator Kit defaults
EDGE_TTS_VOICE="en-US-AriaNeural"
WHISPER_MODEL="base"
OUTPUT_DIR="output"
ASSETS_DIR="assets"
DEFAULT_RESOLUTION="1080x1920"
DEFAULT_FPS="30"
DEFAULT_CRF="18"
WATERMARK_OPACITY="0.3"
MAX_BATCH_WORKERS="2"
FLASK_PORT="5000"

# APP_URL: Automatically injected in cloud runtime
APP_URL="http://localhost:3000"
